# Backend service, installed in /etc/systemd/system by deploy/migrate-server.sh
[Unit]
Description=Guillaume Damiens website
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=guillaumedamiens
Group=guillaumedamiens
WorkingDirectory=/opt/guillaumedamiens
# Secrets (datasource, JWT key, PRIM keys) in /etc/guillaumedamiens/application-prod.yml; logs go to journald
ExecStart=/usr/bin/java -Xms512m -Xmx2g -XX:+ExitOnOutOfMemoryError -jar /opt/guillaumedamiens/current.jar --spring.profiles.active=prod --spring.config.additional-location=file:/etc/guillaumedamiens/
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening. The VPS is an LXC container: systemd can't create mount namespaces there, so PrivateTmp, ProtectSystem,
# ProtectHome, ProtectKernelTunables and ProtectControlGroups make the service fail (status 226/NAMESPACE). The
# application runs as its own unprivileged user and writes to /tmp only (GTFS zip, Tomcat work directory).
NoNewPrivileges=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
