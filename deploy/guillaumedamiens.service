# Backend service, installed in /etc/systemd/system by deploy/migrate-server.sh
[Unit]
Description=Guillaume Damiens website
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=guillaumedamiens
Group=guillaumedamiens
WorkingDirectory=/opt/guillaumedamiens
# Secrets (datasource, JWT key, PRIM keys) in /etc/guillaumedamiens/application-prod.yml; logs go to journald
ExecStart=/usr/bin/java -Xms512m -Xmx2g -XX:+ExitOnOutOfMemoryError -jar /opt/guillaumedamiens/current.jar --spring.profiles.active=prod --spring.config.additional-location=file:/etc/guillaumedamiens/
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening. The application runs as its own unprivileged user. ProtectSystem=strict leaves it the whole file system
# read-only, but its private /tmp (Tomcat work directory) and its state directory /var/lib/guillaumedamiens, created
# for its user by systemd: the GTFS zip is downloaded there (application.gtfs.download-dir), /tmp being too small.
StateDirectory=guillaumedamiens
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
